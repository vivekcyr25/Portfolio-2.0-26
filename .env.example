# ─── NEURAL OS FRONTEND CONFIG ───────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# Firebase Authentication & Firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Enterprise UI License (Syncfusion)
VITE_SYNCFUSION_LICENSE=

# Groq Cloud AI Engine
VITE_GROQ_API_KEY=

# Backend API URL (local dev: http://localhost:5000 | production: your deployed URL)
VITE_API_URL=http://localhost:5000
